# PostgreSQL
POSTGRES_DB=autoqa
POSTGRES_USER=autoqa
POSTGRES_PASSWORD=autoqa_dev_password
POSTGRES_PORT=5432

# Spring Boot Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/autoqa
SPRING_DATASOURCE_USERNAME=autoqa
SPRING_DATASOURCE_PASSWORD=autoqa_dev_password
JWT_SECRET=change-this-to-a-secure-random-string-at-least-64-chars-long-in-production
JWT_EXPIRATION_MS=86400000

# Worker
AUTOQA_API_URL=http://localhost:8080
WORKER_POLL_INTERVAL_MS=3000

# AI Provider (optional for Phase 1)
AI_PROVIDER=none
# OPENAI_API_KEY=sk-...

# Storage
ARTIFACT_STORAGE_PATH=./data/artifacts
UPLOAD_STORAGE_PATH=./data/uploads
WORKSPACE_PATH=./data/workspaces

# Limits
MAX_UPLOAD_SIZE_MB=1024
MAX_EXTRACTED_SIZE_MB=2048
EXECUTION_TIMEOUT_SECONDS=300
